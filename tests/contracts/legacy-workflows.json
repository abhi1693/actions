{
  "python-uv-tests.yml": {
    "inputs": {
      "runs-on": {
        "description": "Runner label for the test job.",
        "required": false,
        "type": "string",
        "default": "ubuntu-latest"
      },
      "python-version": {
        "description": "Python version passed to actions/setup-python.",
        "required": false,
        "type": "string",
        "default": "3.13"
      },
      "uv-version": {
        "description": "Optional uv version; an empty value uses setup-uv's default.",
        "required": false,
        "type": "string",
        "default": ""
      },
      "test-results-path": {
        "description": "Optional path to test reports to upload, relative to the workspace.",
        "required": false,
        "type": "string",
        "default": ""
      },
      "test-results-name": {
        "description": "Unique artifact name when test-results-path is set.",
        "required": false,
        "type": "string",
        "default": "python-test-results"
      },
      "working-directory": {
        "description": "Directory containing the Python project.",
        "required": false,
        "type": "string",
        "default": "."
      },
      "sync-command": {
        "description": "Dependency sync command.",
        "required": false,
        "type": "string",
        "default": "uv sync --extra dev"
      },
      "lint-command": {
        "description": "Optional lint command. Leave empty to skip.",
        "required": false,
        "type": "string",
        "default": ""
      },
      "test-command": {
        "description": "Test command.",
        "required": false,
        "type": "string",
        "default": "uv run pytest"
      }
    }
  },
  "docker-build-push.yml": {
    "inputs": {
      "runs-on": {
        "description": "Runner label for the build job.",
        "required": false,
        "type": "string",
        "default": "ubuntu-24.04-arm"
      },
      "image-title": {
        "description": "Human-readable service name in the Actions job graph.",
        "required": false,
        "type": "string",
        "default": ""
      },
      "matrix": {
        "description": "JSON array of runner/platform pairs. Empty uses runs-on/platforms (ARM64 by default).",
        "required": false,
        "type": "string",
        "default": ""
      },
      "image": {
        "description": "Fully qualified image name passed to docker/metadata-action.",
        "required": true,
        "type": "string"
      },
      "context": {
        "description": "Docker build context.",
        "required": false,
        "type": "string",
        "default": "."
      },
      "source-artifact": {
        "description": "Artifact to download into the checked-out workspace before building.",
        "required": false,
        "type": "string",
        "default": ""
      },
      "source-artifact-path": {
        "description": "Path where the source artifact should be downloaded.",
        "required": false,
        "type": "string",
        "default": "."
      },
      "file": {
        "description": "Dockerfile path.",
        "required": true,
        "type": "string"
      },
      "platforms": {
        "description": "Target platforms for docker/build-push-action.",
        "required": false,
        "type": "string",
        "default": "linux/arm64"
      },
      "qemu": {
        "description": "Whether to set up QEMU before Buildx for cross-platform builds.",
        "required": false,
        "type": "boolean",
        "default": false
      },
      "build-args": {
        "description": "Multiline Docker build args.",
        "required": false,
        "type": "string",
        "default": ""
      },
      "target": {
        "description": "Dockerfile target stage.",
        "required": false,
        "type": "string",
        "default": ""
      },
      "secret-files": {
        "description": "Multiline Docker secret file mappings.",
        "required": false,
        "type": "string",
        "default": ""
      },
      "build-secret-artifact": {
        "description": "Artifact containing a Docker build secret file.",
        "required": false,
        "type": "string",
        "default": ""
      },
      "build-secret-file": {
        "description": "File name inside the build secret artifact.",
        "required": false,
        "type": "string",
        "default": ""
      },
      "build-secret-id": {
        "description": "Docker BuildKit secret id for the artifact file.",
        "required": false,
        "type": "string",
        "default": ""
      },
      "tags": {
        "description": "Multiline docker/metadata-action tag rules.",
        "required": true,
        "type": "string"
      },
      "flavor": {
        "description": "Optional docker/metadata-action flavor configuration.",
        "required": false,
        "type": "string",
        "default": ""
      },
      "labels": {
        "description": "Multiline docker/metadata-action labels.",
        "required": false,
        "type": "string",
        "default": ""
      },
      "cache-scope": {
        "description": "Shared cache scope suffix.",
        "required": true,
        "type": "string"
      },
      "short-sha-length": {
        "description": "DOCKER_METADATA_SHORT_SHA_LENGTH value.",
        "required": false,
        "type": "string",
        "default": "7"
      },
      "push": {
        "description": "Whether to push the built image.",
        "required": false,
        "type": "boolean",
        "default": true
      }
    },
    "secrets": {
      "github-token": {
        "description": "Token used to authenticate to GHCR.",
        "required": true
      }
    },
    "outputs": {
      "tags": {
        "description": "Generated image tags.",
        "value": "${{ inputs.matrix == '' && jobs.build.outputs.tags || jobs.index.outputs.tags }}"
      },
      "labels": {
        "description": "Generated image labels.",
        "value": "${{ inputs.matrix == '' && jobs.build.outputs.labels || jobs.index.outputs.labels }}"
      },
      "digest": {
        "description": "Pushed image digest.",
        "value": "${{ inputs.matrix == '' && jobs.build.outputs.digest || jobs.index.outputs.digest }}"
      }
    }
  }
}
